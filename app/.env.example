# Benchwarmer Analytics environment variables
# For local development put these in .env.local, either at the repo root (where
# `neon link` writes it) or in app/; app/.env.local takes precedence.
# On Vercel, set them in the project's environment settings.

# Pooled connection string (host contains "-pooler"). Used by request handlers
# via the neon-http driver. A localhost URL (e.g. a scratch docker Postgres)
# switches to node-postgres automatically.
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# Direct (non-pooled) connection string, used by drizzle-kit migrations and the
# backfill CLI. Falls back to DATABASE_URL when unset (fine for local Postgres).
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=require

# Shared secret for /api/cron/* routes. Vercel Cron sends it as
# "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
