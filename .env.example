# Benchwarmer Analytics Environment Variables
#
# The TypeScript app's variables (DATABASE_URL, DATABASE_URL_UNPOOLED,
# CRON_SECRET) are documented in client/.env.example.
#
# The variables below are for Docker Compose and the legacy .NET API, which are
# removed in Phase 5 of docs/MIGRATION_PLAN.md.
# Copy this file to .env and update values as needed

# PostgreSQL Configuration (for Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Application Database Connection
# Used by the .NET API when running outside Docker
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=benchwarmer
DATABASE_USER=benchwarmer
DATABASE_PASSWORD=benchwarmer

# Hangfire Database Connection
HANGFIRE_DATABASE_NAME=hangfire
